# Optional source paths. When empty or unset, the helper discovers defaults.
REFLECT_OPENCODE_DB_PATH=
REFLECT_CLAUDE_DATA_PATH=

# Detected sources are enabled by default. Set either value to false to skip it.
REFLECT_USE_OPENCODE=true
REFLECT_USE_CLAUDE=true

# Evidence budget. Known model windows use this percentage; values above 20 warn.
REFLECT_MODEL_CONTEXT_PERCENTAGE_SIZE=20
# Used as the exact evidence budget when model context metadata is unavailable.
REFLECT_FALLBACK_CONTEXT_MAX_TOKENS=100000

# Parallel session workers and bounded retries.
REFLECT_WORKER_LIMIT=4
MAX_REFLECT_WORKER_RETRIES=2
